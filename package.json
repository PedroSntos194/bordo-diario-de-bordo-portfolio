{
  "name": "bordo",
  "version": "0.1.0",
  "private": true,
  "description": "Bordo — Diário de Bordo Digital para frotas de vans",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:portfolio": "node scripts/construir-portfolio.mjs",
    "build:agendador": "esbuild scripts/agendador.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/agendador.mjs --external:@prisma/client --external:@node-rs/argon2 --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cobertura": "vitest run --coverage",
    "test:fluxos": "node scripts/testar-fluxos-http.mjs",
    "test:fluxos:protecoes": "node --test tests/integracao/protecoes.test.mjs",
    "test:ponta-a-ponta": "tsx --env-file-if-exists=.env tests/ponta-a-ponta/todos.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo.ts",
    "agendador": "tsx --env-file-if-exists=.env scripts/agendador.ts",
    "implantacao:conferir": "tsx scripts/acompanhar-implantacao.ts",
    "verificar": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.474.0",
    "maplibre-gl": "^6.5.0",
    "next": "^15.5.28",
    "pg-boss": "^12.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "4.1.11"
  }
}
