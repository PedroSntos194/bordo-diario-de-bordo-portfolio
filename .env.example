# =============================================================================
# Bordo — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o arquivo `.env` (doc 17 · RNF005).
# A aplicação valida estas chaves na inicialização (src/lib/env.ts) e não sobe
# se alguma obrigatória estiver ausente ou inválida.
# =============================================================================

# --- Aplicação -------------------------------------------------------------
NODE_ENV=development
# Ambiente de execução: local | homologacao | producao
# NÃO confundir com NODE_ENV: `next build` roda sempre como production, mesmo
# na sua máquina. É esta variável que ativa as verificações estritas.
APP_AMBIENTE=local
# URL pública da aplicação, sem barra final. Usada em links de notificação.
APP_URL=http://localhost:3000
# Fuso da operação. Datas são gravadas em UTC e exibidas neste fuso (RNF023).
TZ=America/Sao_Paulo

# --- Banco de dados --------------------------------------------------------
DATABASE_URL=postgresql://bordo:bordo@localhost:5432/bordo?schema=public

# --- Sessão ----------------------------------------------------------------
# Segredo de assinatura. Gere com: openssl rand -base64 48
# Precisa ser DIFERENTE entre homologação e produção.
SESSAO_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-caracteres

# --- Armazenamento de arquivos --------------------------------------------
# Diretório fora da pasta pública. Nada aqui é servido por URL direta (doc 17):
# o download passa sempre por /api/arquivos/{id}/download, que confere permissão.
# `s3` usa um bucket privado compatível com S3 (AWS, R2, MinIO etc.; doc 27).
STORAGE_DRIVER=local
STORAGE_PATH=./storage
# Obrigatórias somente quando STORAGE_DRIVER=s3:
# S3_BUCKET=
# S3_REGIAO=
# S3_ENDPOINT=
# S3_CHAVE_ID=
# S3_CHAVE_SECRETA=

# --- WhatsApp (V-05) -------------------------------------------------------
# link  = abre o WhatsApp com a mensagem pronta (MVP, sem custo)
# cloud = envio automático pela Cloud API oficial da Meta (exige os valores abaixo)
#
# Trocar para `cloud` só faz sentido depois que a conta Meta Business estiver
# verificada e o template aprovado — o resumo do dia chega sem conversa aberta,
# ou seja, sempre fora da janela de 24h, onde a Meta exige template.
WHATSAPP_CANAL=link
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_RESUMO=resumo_do_dia

# --- Seed (opcional) -------------------------------------------------------
# Sem isto o administrador inicial nasce com um telefone de exemplo, que não é
# discável — e o resumo do dia por WhatsApp fica sem destinatário até alguém
# corrigir o cadastro em Usuários. O seed avisa quando isso acontece.
# SEED_ADMIN_TELEFONE=+5511999998888

# --- Mapas (V-06) ----------------------------------------------------------
MAPA_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODIFICACAO_URL=https://nominatim.openstreetmap.org/reverse

# --- Observabilidade -------------------------------------------------------
LOG_NIVEL=info

# Autoriza a chamada das rotinas agendadas em /api/cron (doc 27).
# Gere com: openssl rand -base64 36
# Sem este valor a rota recusa tudo — inclusive em desenvolvimento.
# Vazio não vale: descomente só quando tiver o segredo (mínimo de 24 caracteres).
# CRON_SECRET=

# Migrações, sempre SEM pool. Sem pooler aqui, é a mesma string da acima.
DIRECT_URL=postgresql://bordo:bordo@localhost:5432/bordo?schema=public
