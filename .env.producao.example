# =============================================================================
# Bordo — variáveis de PRODUÇÃO (US046 · RNF005)
#
# Copie para `.env.producao` no servidor e preencha. Esse arquivo **nunca** é
# versionado e **nunca** entra na imagem — ver a nota no `.dockerignore` sobre o
# `.env` que o `next build` copia para dentro do `standalone`.
#
#   cp .env.producao.example .env.producao
#   chmod 600 .env.producao
#   docker compose --env-file .env.producao up -d
#
# Diferente do `.env.example`, que descreve a máquina de quem desenvolve, aqui
# tudo precisa de valor real: a aplicação recusa subir com segredo de exemplo
# quando APP_AMBIENTE=producao (src/lib/env.ts).
# =============================================================================

# --- Identidade da instalação ----------------------------------------------
# `producao` liga as verificações estritas: segredo real e HTTPS obrigatórios.
# Use `homologacao` no ambiente de testes com o cliente.
APP_AMBIENTE=producao

# Precisa ser HTTPS em produção, sem barra no final. É a base dos links que vão
# na mensagem de WhatsApp — se estiver errada, o administrador recebe link morto.
APP_URL=https://bordo.exemplo.com.br

TZ=America/Sao_Paulo
LOG_NIVEL=info

# Etiqueta da imagem. Use a versão do release, não `latest`: sem isso não há
# como voltar para a anterior num rollback.
VERSAO=1.0.0

# --- Domínio e certificado --------------------------------------------------
# Precisa apontar para o IP deste servidor ANTES da primeira subida: o desafio
# da Let's Encrypt bate na porta 80 deste host.
DOMINIO=bordo.exemplo.com.br
# Recebe os avisos de expiração de certificado. Use uma caixa que alguém lê.
EMAIL_ACME=ti@exemplo.com.br

# --- Banco de dados ---------------------------------------------------------
# O serviço `banco` do compose é criado com estes valores na primeira subida.
# Alterar a senha depois NÃO reconfigura o volume existente — é preciso alterar
# no PostgreSQL também.
POSTGRES_USER=bordo
POSTGRES_DB=bordo
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Sessão -----------------------------------------------------------------
# Gere com: openssl rand -base64 48
# Precisa ser DIFERENTE do valor de homologação. Trocar este segredo derruba
# todas as sessões ativas — útil como resposta a incidente.
SESSAO_SECRET=

# --- Cópias de segurança ----------------------------------------------------
# Dias de retenção local. O volume `copias-de-seguranca` é a primeira linha, não
# a única: replique para fora do servidor (RNF013).
BACKUP_RETENCAO_DIAS=14

# --- WhatsApp (V-05) --------------------------------------------------------
# `link` é o MVP: o motorista confirma o envio no aplicativo dele. Só mude para
# `cloud` depois que a conta Meta Business estiver verificada e o template
# aprovado — a aplicação recusa subir em `cloud` sem token e phone number id.
WHATSAPP_CANAL=link
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_RESUMO=resumo_do_dia

# --- Serviços de mapa (V-06) ------------------------------------------------
# Chamadas de saída feitas pelo servidor. A política do Nominatim tem limite de
# uso; se a operação crescer, avaliar provedor pago (doc 14).
MAPA_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODIFICACAO_URL=https://nominatim.openstreetmap.org/reverse

# --- Semente inicial --------------------------------------------------------
# Usados uma única vez, na criação do administrador. Sem o telefone, o resumo do
# dia por WhatsApp nasce sem destinatário — o seed avisa quando isso acontece.
SEED_ADMIN_CPF=
SEED_ADMIN_NOME=
SEED_ADMIN_TELEFONE=

# Autoriza a chamada das rotinas agendadas em /api/cron (doc 27).
# Gere com: openssl rand -base64 36
# Sem este valor a rota recusa tudo — inclusive em desenvolvimento.
CRON_SECRET=

# Migrações, sempre SEM pool: o Prisma Migrate não funciona pelo PgBouncer.
# No Neon, é a mesma string SEM o sufixo `-pooler` no host.
DIRECT_URL=
